import QtQuick
import QtQuick.Controls
import QtQuick.Layouts
import qs.Commons
import qs.Ui
import "Model.js" as Model

// New login form. ↵ moves to the next field, Ctrl+↵ saves, Esc goes back.
// A blank password is generated by Proton Pass on save.
FocusScope {
  id: root

  property var panel: null
  property var pass: null

  property string shareId: ""
  property bool attempted: false
  property bool showPassword: false
  property bool awaitingGenerated: false

  readonly property bool titleMissing: titleField.text.trim() === ""

  function prepare(title, password, vault) {
    titleField.text = String(title || "")
    usernameField.text = ""
    urlField.text = ""
    passwordField.text = String(password || "")
    shareId = String(vault || "")
    attempted = false
    showPassword = password !== ""
    awaitingGenerated = false
    scroller.contentY = 0
  }

  // Leaving the form drops any pending generated password.
  onVisibleChanged: if (!visible) awaitingGenerated = false

  function focusFirst() {
    titleField.forceActiveFocus()
  }

  function save() {
    attempted = true
    if (titleMissing || pass.creating) {
      if (titleMissing) titleField.forceActiveFocus()
      return
    }
    var login = usernameField.text.trim()
    var isEmail = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(login)
    pass.createLogin({
      shareId: shareId,
      title: titleField.text.trim(),
      username: isEmail ? "" : login,
      email: isEmail ? login : "",
      password: passwordField.text,
      url: urlField.text.trim()
    })
  }

  function generate() {
    awaitingGenerated = true
    pass.generate({ mode: "random", length: 20 })
  }

  Connections {
    target: pass
    function onGeneratedChanged() {
      if (!root.awaitingGenerated || !root.visible) return
      root.awaitingGenerated = false
      passwordField.text = pass.generated
      root.showPassword = true
    }
  }

  // Keys shared by every field.
  function fieldKey(event, next) {
    var ctrl = (event.modifiers & Qt.ControlModifier) !== 0
    if (event.key === Qt.Key_Escape) {
      panel.back()
    } else if ((event.key === Qt.Key_Return || event.key === Qt.Key_Enter) && (ctrl || !next)) {
      save()
    } else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {
      next.forceActiveFocus()
    } else if (ctrl && event.key === Qt.Key_G) {
      generate()
    } else {
      return
    }
    event.accepted = true
  }

  Flickable {
    id: scroller
    anchors.fill: parent
    contentWidth: width
    contentHeight: form.implicitHeight
    clip: true
    boundsBehavior: Flickable.StopAtBounds
    ScrollBar.vertical: ScrollBar { policy: ScrollBar.AsNeeded }

    ColumnLayout {
      id: form
      width: scroller.width
      spacing: Style.space(6)

      FormLabel { text: "Title"; required: true }
      TextField {
        id: titleField
        Layout.fillWidth: true
        placeholderText: "e.g. GitHub"
        foreground: panel.foreground
        font.family: panel.fontFamily
        Keys.onPressed: function(event) { root.fieldKey(event, usernameField) }
      }
      Text {
        visible: root.attempted && root.titleMissing
        text: "A title is required."
        color: panel.urgent
        font.family: panel.fontFamily
        font.pixelSize: Style.font.caption
      }

      FormLabel { text: "Username or email" }
      TextField {
        id: usernameField
        Layout.fillWidth: true
        placeholderText: "you@example.com"
        foreground: panel.foreground
        font.family: panel.fontFamily
        Keys.onPressed: function(event) { root.fieldKey(event, urlField) }
      }

      FormLabel { text: "Website" }
      TextField {
        id: urlField
        Layout.fillWidth: true
        placeholderText: "example.com"
        foreground: panel.foreground
        font.family: panel.fontFamily
        Keys.onPressed: function(event) { root.fieldKey(event, passwordField) }
      }

      FormLabel { text: "Password" }
      RowLayout {
        Layout.fillWidth: true
        spacing: Style.space(4)

        TextField {
          id: passwordField
          Layout.fillWidth: true
          placeholderText: "Blank = generate on save"
          password: !root.showPassword
          foreground: panel.foreground
          font.family: root.showPassword ? "monospace" : panel.fontFamily
          Keys.onPressed: function(event) { root.fieldKey(event, null) }
        }
        PanelActionButton {
          iconText: root.showPassword ? "󰈉" : "󰈈"
          tooltipText: root.showPassword ? "Hide" : "Show"
          foreground: panel.foreground
          fontFamily: panel.fontFamily
          onClicked: root.showPassword = !root.showPassword
        }
        PanelActionButton {
          iconText: "󰟵"
          tooltipText: "Generate (Ctrl+G)"
          enabled: !pass.generating
          foreground: panel.foreground
          fontFamily: panel.fontFamily
          onClicked: root.generate()
        }
      }

      FormLabel { text: "Vault"; visible: panel.vaults.length > 1 }
      Dropdown {
        Layout.fillWidth: true
        visible: panel.vaults.length > 1
        showLabel: false
        label: "Vault"
        value: root.shareId
        options: panel.vaults.map(function(v) { return { value: v.shareId, label: v.name } })
        foreground: panel.foreground
        fontFamily: panel.fontFamily
        onChanged: function(value) { root.shareId = value }
      }

      Item { implicitHeight: Style.space(6) }

      Button {
        Layout.fillWidth: true
        text: pass.creating ? "Saving…" : "Save login"
        iconText: pass.creating ? "󰑮" : "󰄬"
        iconSpinning: pass.creating
        enabled: !pass.creating
        selected: true
        bordered: true
        foreground: panel.foreground
        fontFamily: panel.fontFamily
        verticalPadding: Style.space(9)
        onClicked: root.save()
      }
    }
  }

  component FormLabel: Row {
    property alias text: labelText.text
    property bool required: false
    Layout.topMargin: Style.space(4)
    spacing: Style.space(4)

    Text {
      id: labelText
      color: panel.foreground
      font.family: panel.fontFamily
      font.pixelSize: Style.font.caption
      font.bold: true
    }
    Text {
      visible: parent.required
      text: "required"
      color: panel.dim
      font.family: panel.fontFamily
      font.pixelSize: Style.font.caption
    }
  }
}
